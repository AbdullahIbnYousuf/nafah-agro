# Backend runtime
NODE_ENV=development
PORT=4000
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
PROTECTED_RATE_LIMIT_MAX=300
OWNER_INVITE_RATE_LIMIT_MAX=5

# Cloudinary (required together in production)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Supabase PostgreSQL/Auth (required for authentication and all application data)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Backend-only. Required in production for OWNER invitations/account administration.
# Never expose this value through a VITE_ variable.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OWNER web push notifications (required together in production)
# Generate one permanent pair with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:owner@example.com
# Generate a long random value, for example: openssl rand -base64 36
CRON_SECRET=your-long-random-cron-secret

# Frontend-public values only. Never use a service-role key in a VITE_ variable.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
