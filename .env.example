# Backend runtime
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/nafah_agro
FRONTEND_URL=http://localhost:8080
JSON_BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
PROTECTED_RATE_LIMIT_MAX=60

# LEGACY ONLY: MONGO_URI is required only by the temporary MongoDB order routes.
# Remove it after the PostgreSQL order vertical replaces every order consumer.

# Cloudinary: uncomment all three together when upload testing is needed
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Supabase PostgreSQL/Auth (required for authentication and the product catalog)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Frontend-public values only. Never use a service-role key in a VITE_ variable.
VITE_API_URL=/api
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
