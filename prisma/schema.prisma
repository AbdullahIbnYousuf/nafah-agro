generator client {
  provider            = "prisma-client"
  output              = "../server/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  CUSTOMER
}

model Profile {
  id          String   @id @db.Uuid
  role        Role
  fullName    String   @map("full_name")
  phoneNumber String?  @map("phone_number")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  priceChanges SellingPriceHistory[]

  @@map("profiles")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("categories")
}

model Product {
  id           String           @id @default(uuid()) @db.Uuid
  categoryId   String           @db.Uuid @map("category_id")
  name         String
  slug         String           @unique
  description  String           @default("")
  featured     Boolean          @default(false)
  isActive     Boolean          @default(true) @map("is_active")
  tags         String[]         @default([])
  images       String[]         @default([])
  youtubeLinks String[]         @default([]) @map("youtube_links")
  attributes   Json             @default("[]")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants     ProductVariant[]

  @@index([categoryId, isActive])
  @@map("products")
}

model ProductVariant {
  id                  String                @id @default(uuid()) @db.Uuid
  productId           String                @db.Uuid @map("product_id")
  name                String
  sku                 String                @unique
  currentSellingPrice Decimal               @db.Decimal(14, 2) @map("current_selling_price")
  availableStock      Int                   @default(0) @map("available_stock")
  reservedStock       Int                   @default(0) @map("reserved_stock")
  lowStockThreshold   Int                   @default(5) @map("low_stock_threshold")
  isDefault           Boolean               @default(false) @map("is_default")
  isActive            Boolean               @default(true) @map("is_active")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  product             Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceHistory        SellingPriceHistory[]

  @@index([productId, isActive])
  @@map("product_variants")
}

model SellingPriceHistory {
  id                 String         @id @default(uuid()) @db.Uuid
  variantId          String         @db.Uuid @map("variant_id")
  previousPrice      Decimal?       @db.Decimal(14, 2) @map("previous_price")
  newPrice           Decimal        @db.Decimal(14, 2) @map("new_price")
  reason             String
  changedByProfileId String         @db.Uuid @map("changed_by_profile_id")
  effectiveAt        DateTime       @default(now()) @map("effective_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  variant            ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  changedBy          Profile        @relation(fields: [changedByProfileId], references: [id], onDelete: Restrict)

  @@index([variantId, effectiveAt])
  @@map("selling_price_history")
}

model FoundationRecord {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("foundation_records")
}
