generator client {
  provider            = "prisma-client"
  output              = "../server/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  CUSTOMER
}

enum StockBatchSource {
  PURCHASE
  ADJUSTMENT
  SELLABLE_RETURN
}

enum StockAdjustmentDirection {
  INCREASE
  DECREASE
}

enum AllocationState {
  RESERVED
  CONSUMED
  RELEASED
}

enum SalesOrderSource {
  WEBSITE
  PHYSICAL_SHOP
  FACEBOOK
  PHONE
  WHATSAPP
  OTHER
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED_SELLABLE
  RETURNED_DAMAGED
}

enum SalesPaymentMethod {
  CASH
  CASH_ON_DELIVERY
  CREDIT
}

enum SalesPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum DeliveryRateCode {
  DHAKA
  OUTSIDE_DHAKA
}

enum ReturnCondition {
  SELLABLE
  DAMAGED
}

enum ProductKind {
  PACKAGED
  LOOSE_WEIGHT
  LOOSE_VOLUME
  EGG
}

enum SellingPriceTier {
  REGULAR
  EGG_BULK
}

enum QuantityUnit {
  PIECE
  GRAM
  MILLILITER
}

enum PushNotificationType {
  WEBSITE_ORDER
  CREDIT_REMINDER
  TEST
}

enum PushDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Profile {
  id                    String                @id @db.Uuid
  role                  Role
  fullName              String                @map("full_name")
  phoneNumber           String?               @map("phone_number")
  isActive              Boolean               @default(true) @map("is_active")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  priceChanges          SellingPriceHistory[]
  stockBatches          StockBatch[]
  stockAdjustments      StockAdjustment[]
  createdSales          SalesOrder[]          @relation("CreatedSales")
  customerSales         SalesOrder[]          @relation("CustomerSales")
  unprofitableOverrides SalesOrder[]          @relation("UnprofitableOverrides")
  updatedDeliveryRates  DeliveryRate[]
  auditLogs             AuditLog[]
  physicalSaleReturns   PhysicalSaleReturn[]
  creditPaymentsCreated CreditPayment[] @relation("CreditPaymentsCreated")
  creditPaymentsVoided  CreditPayment[] @relation("CreditPaymentsVoided")
  creditCustomersCreated CreditCustomer[] @relation("CreditCustomersCreated")
  customerCreditPaymentsCreated CreditCustomerPayment[] @relation("CustomerCreditPaymentsCreated")
  customerCreditPaymentsVoided  CreditCustomerPayment[] @relation("CustomerCreditPaymentsVoided")
  pushSubscriptions     PushSubscription[]

  @@map("profiles")
}

model Category {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  slug            String    @unique
  isActive        Boolean   @default(true) @map("is_active")
  isVisibleInShop Boolean   @default(true) @map("is_visible_in_shop")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  products        Product[]

  @@map("categories")
}

model Product {
  id           String           @id @default(uuid()) @db.Uuid
  categoryId   String           @map("category_id") @db.Uuid
  name         String
  slug         String           @unique
  description  String           @default("")
  kind         ProductKind      @default(PACKAGED)
  featured     Boolean          @default(false)
  isActive     Boolean          @default(true) @map("is_active")
  isVisibleInShop Boolean       @default(true) @map("is_visible_in_shop")
  tags         String[]         @default([])
  images       String[]         @default([])
  youtubeLinks String[]         @default([]) @map("youtube_links")
  attributes   Json             @default("[]")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants     ProductVariant[]

  @@index([categoryId, isActive])
  @@index([categoryId, isActive, isVisibleInShop])
  @@map("products")
}

model ProductVariant {
  id                  String                @id @default(uuid()) @db.Uuid
  productId           String                @map("product_id") @db.Uuid
  name                String
  sku                 String                @unique
  currentSellingPrice Decimal               @map("current_selling_price") @db.Decimal(14, 2)
  bulkSellingPrice    Decimal?              @map("bulk_selling_price") @db.Decimal(14, 2)
  availableStock      Int                   @default(0) @map("available_stock")
  reservedStock       Int                   @default(0) @map("reserved_stock")
  lowStockThreshold   Int                   @default(5) @map("low_stock_threshold")
  isDefault           Boolean               @default(false) @map("is_default")
  isActive            Boolean               @default(true) @map("is_active")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  product             Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceHistory        SellingPriceHistory[]
  stockBatches        StockBatch[]
  stockAdjustments    StockAdjustment[]
  salesOrderItems     SalesOrderItem[]

  @@index([productId, isActive])
  @@map("product_variants")
}

model SellingPriceHistory {
  id                 String         @id @default(uuid()) @db.Uuid
  variantId          String         @map("variant_id") @db.Uuid
  previousPrice      Decimal?       @map("previous_price") @db.Decimal(14, 2)
  newPrice           Decimal        @map("new_price") @db.Decimal(14, 2)
  priceTier          SellingPriceTier @default(REGULAR) @map("price_tier")
  reason             String
  changedByProfileId String         @map("changed_by_profile_id") @db.Uuid
  effectiveAt        DateTime       @default(now()) @map("effective_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  variant            ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  changedBy          Profile        @relation(fields: [changedByProfileId], references: [id], onDelete: Restrict)

  @@index([variantId, effectiveAt])
  @@map("selling_price_history")
}

model StockBatch {
  id                           String                        @id @default(uuid()) @db.Uuid
  purchaseGroupId              String?                       @map("purchase_group_id") @db.Uuid
  productVariantId             String                        @map("product_variant_id") @db.Uuid
  source                       StockBatchSource
  purchasedQuantity            Int                           @map("purchased_quantity")
  availableQuantity            Int                           @map("available_quantity")
  reservedQuantity             Int                           @default(0) @map("reserved_quantity")
  unitBuyingCost               Decimal                       @map("unit_buying_cost") @db.Decimal(14, 2)
  purchaseDate                 DateTime                      @map("purchase_date") @db.Date
  note                         String?
  adjustmentReason             String?                       @map("adjustment_reason")
  createdByProfileId           String                        @map("created_by_profile_id") @db.Uuid
  createdAt                    DateTime                      @default(now()) @map("created_at")
  updatedAt                    DateTime                      @updatedAt @map("updated_at")
  productVariant               ProductVariant                @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  createdBy                    Profile                       @relation(fields: [createdByProfileId], references: [id], onDelete: Restrict)
  orderAllocations             OrderAllocation[]
  physicalSaleReturnAllocation PhysicalSaleReturnAllocation?
  sourceSalesOrderId           String?                       @map("source_sales_order_id") @db.Uuid
  sourceSalesOrder             SalesOrder?                   @relation("ReturnStockBatches", fields: [sourceSalesOrderId], references: [id], onDelete: Restrict)

  @@index([productVariantId, purchaseDate, createdAt])
  @@index([purchaseGroupId])
  @@map("stock_batches")
}

model StockAdjustment {
  id                 String                   @id @default(uuid()) @db.Uuid
  productVariantId   String                   @map("product_variant_id") @db.Uuid
  direction          StockAdjustmentDirection
  quantity           Int
  unitBuyingCost     Decimal?                 @map("unit_buying_cost") @db.Decimal(14, 2)
  reason             String
  createdByProfileId String                   @map("created_by_profile_id") @db.Uuid
  createdAt          DateTime                 @default(now()) @map("created_at")
  productVariant     ProductVariant           @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  createdBy          Profile                  @relation(fields: [createdByProfileId], references: [id], onDelete: Restrict)

  @@index([productVariantId, createdAt])
  @@map("stock_adjustments")
}

model SalesOrder {
  id                              String               @id @default(uuid()) @db.Uuid
  orderNumber                     String               @unique @map("order_number")
  idempotencyKey                  String?              @unique @map("idempotency_key")
  requestFingerprint              String?              @map("request_fingerprint")
  source                          SalesOrderSource     @default(PHYSICAL_SHOP)
  status                          SalesOrderStatus     @default(COMPLETED)
  paymentMethod                   SalesPaymentMethod   @default(CASH) @map("payment_method")
  paymentStatus                   SalesPaymentStatus   @default(PAID) @map("payment_status")
  customerProfileId               String?              @map("customer_profile_id") @db.Uuid
  creditCustomerId                String?              @map("credit_customer_id") @db.Uuid
  customerName                    String?              @map("customer_name")
  customerPhone                   String?              @map("customer_phone")
  customerEmail                   String?              @map("customer_email")
  customerAddress                 String?              @map("customer_address")
  deliveryRateId                  String?              @map("delivery_rate_id") @db.Uuid
  deliveryCharge                  Decimal              @default(0) @map("delivery_charge") @db.Decimal(14, 2)
  subtotal                        Decimal              @db.Decimal(14, 2)
  discountTotal                   Decimal              @default(0) @map("discount_total") @db.Decimal(14, 2)
  grandTotal                      Decimal              @map("grand_total") @db.Decimal(14, 2)
  totalBuyingCost                 Decimal?             @map("total_buying_cost") @db.Decimal(14, 2)
  grossProfit                     Decimal?             @map("gross_profit") @db.Decimal(14, 2)
  grossProfitMargin               Decimal?             @map("gross_profit_margin") @db.Decimal(7, 4)
  unprofitableOverrideConfirmed   Boolean              @default(false) @map("unprofitable_override_confirmed")
  unprofitableOverrideByProfileId String?              @map("unprofitable_override_by_profile_id") @db.Uuid
  createdByProfileId              String?              @map("created_by_profile_id") @db.Uuid
  placedAt                        DateTime             @default(now()) @map("placed_at")
  confirmedAt                     DateTime?            @map("confirmed_at")
  completedAt                     DateTime?            @map("completed_at")
  deliveredAt                     DateTime?            @map("delivered_at")
  cancelledAt                     DateTime?            @map("cancelled_at")
  returnedAt                      DateTime?            @map("returned_at")
  nextFollowUpDate                DateTime?            @map("next_follow_up_date") @db.Date
  statusReason                    String?              @map("status_reason")
  returnCondition                 ReturnCondition?     @map("return_condition")
  createdAt                       DateTime             @default(now()) @map("created_at")
  updatedAt                       DateTime             @updatedAt @map("updated_at")
  createdBy                       Profile?             @relation("CreatedSales", fields: [createdByProfileId], references: [id], onDelete: Restrict)
  customerProfile                 Profile?             @relation("CustomerSales", fields: [customerProfileId], references: [id], onDelete: SetNull)
  creditCustomer                  CreditCustomer?      @relation(fields: [creditCustomerId], references: [id], onDelete: Restrict)
  deliveryRate                    DeliveryRate?        @relation(fields: [deliveryRateId], references: [id], onDelete: Restrict)
  unprofitableOverrideBy          Profile?             @relation("UnprofitableOverrides", fields: [unprofitableOverrideByProfileId], references: [id], onDelete: Restrict)
  items                           SalesOrderItem[]
  returnStockBatches              StockBatch[]         @relation("ReturnStockBatches")
  physicalSaleReturns             PhysicalSaleReturn[]
  creditPayments                  CreditPayment[]
  creditPaymentAllocations        CreditCustomerPaymentAllocation[]

  @@index([source, status, placedAt])
  @@index([paymentMethod, paymentStatus, nextFollowUpDate])
  @@index([customerProfileId, placedAt])
  @@index([creditCustomerId, completedAt])
  @@index([customerPhone])
  @@index([completedAt])
  @@index([deliveredAt])
  @@index([returnedAt])
  @@map("sales_orders")
}

model CreditCustomer {
  id               String                  @id @default(uuid()) @db.Uuid
  name             String
  normalizedName   String                  @unique @map("normalized_name")
  phone            String?
  nextFollowUpDate DateTime?               @map("next_follow_up_date") @db.Date
  createdByProfileId String                @map("created_by_profile_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  createdBy        Profile                 @relation("CreditCustomersCreated", fields: [createdByProfileId], references: [id], onDelete: Restrict)
  sales            SalesOrder[]
  payments         CreditCustomerPayment[]

  @@index([nextFollowUpDate])
  @@map("credit_customers")
}

model CreditCustomerPayment {
  id                 String    @id @default(uuid()) @db.Uuid
  creditCustomerId   String    @map("credit_customer_id") @db.Uuid
  idempotencyKey     String    @unique @map("idempotency_key") @db.Uuid
  amount             Decimal   @db.Decimal(14, 2)
  paidOn             DateTime  @map("paid_on") @db.Date
  note               String?
  createdByProfileId String    @map("created_by_profile_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  voidedAt           DateTime? @map("voided_at")
  voidedByProfileId  String?   @map("voided_by_profile_id") @db.Uuid
  voidReason         String?   @map("void_reason")
  creditCustomer     CreditCustomer @relation(fields: [creditCustomerId], references: [id], onDelete: Restrict)
  createdBy          Profile @relation("CustomerCreditPaymentsCreated", fields: [createdByProfileId], references: [id], onDelete: Restrict)
  voidedBy           Profile? @relation("CustomerCreditPaymentsVoided", fields: [voidedByProfileId], references: [id], onDelete: Restrict)
  allocations        CreditCustomerPaymentAllocation[]

  @@index([creditCustomerId, paidOn, createdAt])
  @@map("credit_customer_payments")
}

model CreditCustomerPaymentAllocation {
  id              String   @id @default(uuid()) @db.Uuid
  creditPaymentId String   @map("credit_payment_id") @db.Uuid
  salesOrderId    String   @map("sales_order_id") @db.Uuid
  amount          Decimal  @db.Decimal(14, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  creditPayment   CreditCustomerPayment @relation(fields: [creditPaymentId], references: [id], onDelete: Restrict)
  salesOrder      SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)

  @@unique([creditPaymentId, salesOrderId])
  @@index([salesOrderId])
  @@map("credit_customer_payment_allocations")
}

model SalesOrderItem {
  id                      String                   @id @default(uuid()) @db.Uuid
  salesOrderId            String                   @map("sales_order_id") @db.Uuid
  productId               String                   @map("product_id") @db.Uuid
  productVariantId        String                   @map("product_variant_id") @db.Uuid
  productNameSnapshot     String                   @map("product_name_snapshot")
  variantNameSnapshot     String                   @map("variant_name_snapshot")
  skuSnapshot             String                   @map("sku_snapshot")
  quantity                Int
  quantityUnit            QuantityUnit             @default(PIECE) @map("quantity_unit")
  unitSellingPrice        Decimal                  @map("unit_selling_price") @db.Decimal(14, 2)
  sellingPriceTier        SellingPriceTier         @default(REGULAR) @map("selling_price_tier")
  grossLineRevenue        Decimal                  @map("gross_line_revenue") @db.Decimal(14, 2)
  allocatedDiscount       Decimal                  @default(0) @map("allocated_discount") @db.Decimal(14, 2)
  netLineRevenue          Decimal                  @map("net_line_revenue") @db.Decimal(14, 2)
  totalBuyingCost         Decimal?                 @map("total_buying_cost") @db.Decimal(14, 2)
  grossProfit             Decimal?                 @map("gross_profit") @db.Decimal(14, 2)
  createdAt               DateTime                 @default(now()) @map("created_at")
  salesOrder              SalesOrder               @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  productVariant          ProductVariant           @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  allocations             OrderAllocation[]
  physicalSaleReturnItems PhysicalSaleReturnItem[]

  @@index([salesOrderId])
  @@index([productVariantId])
  @@map("sales_order_items")
}

model OrderAllocation {
  id                            String                         @id @default(uuid()) @db.Uuid
  salesOrderItemId              String                         @map("sales_order_item_id") @db.Uuid
  stockBatchId                  String                         @map("stock_batch_id") @db.Uuid
  quantity                      Int
  unitBuyingCost                Decimal                        @map("unit_buying_cost") @db.Decimal(14, 2)
  totalBuyingCost               Decimal                        @map("total_buying_cost") @db.Decimal(14, 2)
  state                         AllocationState                @default(CONSUMED)
  reservedAt                    DateTime?                      @map("reserved_at")
  consumedAt                    DateTime?                      @map("consumed_at")
  releasedAt                    DateTime?                      @map("released_at")
  createdAt                     DateTime                       @default(now()) @map("created_at")
  updatedAt                     DateTime                       @updatedAt @map("updated_at")
  salesOrderItem                SalesOrderItem                 @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)
  stockBatch                    StockBatch                     @relation(fields: [stockBatchId], references: [id], onDelete: Restrict)
  physicalSaleReturnAllocations PhysicalSaleReturnAllocation[]

  @@index([salesOrderItemId])
  @@index([stockBatchId, state])
  @@map("order_allocations")
}

model PhysicalSaleReturn {
  id                  String                   @id @default(uuid()) @db.Uuid
  salesOrderId        String                   @map("sales_order_id") @db.Uuid
  condition           ReturnCondition
  reason              String
  refundAmount        Decimal                  @map("refund_amount") @db.Decimal(14, 2)
  creditOffsetAmount  Decimal                  @default(0) @map("credit_offset_amount") @db.Decimal(14, 2)
  cashRefundAmount    Decimal                  @default(0) @map("cash_refund_amount") @db.Decimal(14, 2)
  reversedBuyingCost  Decimal                  @map("reversed_buying_cost") @db.Decimal(14, 2)
  reversedGrossProfit Decimal                  @map("reversed_gross_profit") @db.Decimal(14, 2)
  createdByProfileId  String                   @map("created_by_profile_id") @db.Uuid
  createdAt           DateTime                 @default(now()) @map("created_at")
  salesOrder          SalesOrder               @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  createdBy           Profile                  @relation(fields: [createdByProfileId], references: [id], onDelete: Restrict)
  items               PhysicalSaleReturnItem[]

  @@index([salesOrderId, createdAt])
  @@map("physical_sale_returns")
}

model CreditPayment {
  id                  String    @id @default(uuid()) @db.Uuid
  salesOrderId        String    @map("sales_order_id") @db.Uuid
  idempotencyKey      String    @unique @map("idempotency_key") @db.Uuid
  amount              Decimal   @db.Decimal(14, 2)
  paidOn              DateTime  @map("paid_on") @db.Date
  note                String?
  createdByProfileId  String    @map("created_by_profile_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  voidedAt            DateTime? @map("voided_at")
  voidedByProfileId   String?   @map("voided_by_profile_id") @db.Uuid
  voidReason          String?   @map("void_reason")
  salesOrder          SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  createdBy           Profile    @relation("CreditPaymentsCreated", fields: [createdByProfileId], references: [id], onDelete: Restrict)
  voidedBy            Profile?   @relation("CreditPaymentsVoided", fields: [voidedByProfileId], references: [id], onDelete: Restrict)

  @@index([salesOrderId, paidOn, createdAt])
  @@map("credit_payments")
}

model PushSubscription {
  id               String         @id @default(uuid()) @db.Uuid
  profileId        String         @map("profile_id") @db.Uuid
  endpoint         String         @unique
  p256dh           String
  auth             String
  userAgent        String?        @map("user_agent")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  lastSuccessfulAt DateTime?      @map("last_successful_at")
  profile          Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  deliveries       PushDelivery[]

  @@index([profileId, updatedAt])
  @@map("push_subscriptions")
}

model PushDelivery {
  id             String               @id @default(uuid()) @db.Uuid
  subscriptionId String               @map("subscription_id") @db.Uuid
  type           PushNotificationType
  dedupeKey      String               @unique @map("dedupe_key")
  status         PushDeliveryStatus   @default(PENDING)
  attemptedAt    DateTime             @default(now()) @map("attempted_at")
  sentAt         DateTime?            @map("sent_at")
  failureCode    String?              @map("failure_code")
  subscription   PushSubscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, attemptedAt])
  @@map("push_deliveries")
}

model PhysicalSaleReturnItem {
  id                   String                         @id @default(uuid()) @db.Uuid
  physicalSaleReturnId String                         @map("physical_sale_return_id") @db.Uuid
  salesOrderItemId     String                         @map("sales_order_item_id") @db.Uuid
  quantity             Int
  refundAmount         Decimal                        @map("refund_amount") @db.Decimal(14, 2)
  reversedBuyingCost   Decimal                        @map("reversed_buying_cost") @db.Decimal(14, 2)
  reversedGrossProfit  Decimal                        @map("reversed_gross_profit") @db.Decimal(14, 2)
  createdAt            DateTime                       @default(now()) @map("created_at")
  physicalSaleReturn   PhysicalSaleReturn             @relation(fields: [physicalSaleReturnId], references: [id], onDelete: Restrict)
  salesOrderItem       SalesOrderItem                 @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)
  allocations          PhysicalSaleReturnAllocation[]

  @@unique([physicalSaleReturnId, salesOrderItemId])
  @@index([salesOrderItemId])
  @@map("physical_sale_return_items")
}

model PhysicalSaleReturnAllocation {
  id                       String                 @id @default(uuid()) @db.Uuid
  physicalSaleReturnItemId String                 @map("physical_sale_return_item_id") @db.Uuid
  orderAllocationId        String                 @map("order_allocation_id") @db.Uuid
  restoredStockBatchId     String?                @unique @map("restored_stock_batch_id") @db.Uuid
  quantity                 Int
  unitBuyingCost           Decimal                @map("unit_buying_cost") @db.Decimal(14, 2)
  totalBuyingCost          Decimal                @map("total_buying_cost") @db.Decimal(14, 2)
  createdAt                DateTime               @default(now()) @map("created_at")
  physicalSaleReturnItem   PhysicalSaleReturnItem @relation(fields: [physicalSaleReturnItemId], references: [id], onDelete: Restrict)
  orderAllocation          OrderAllocation        @relation(fields: [orderAllocationId], references: [id], onDelete: Restrict)
  restoredStockBatch       StockBatch?            @relation(fields: [restoredStockBatchId], references: [id], onDelete: Restrict)

  @@index([physicalSaleReturnItemId])
  @@index([orderAllocationId])
  @@map("physical_sale_return_allocations")
}

model DeliveryRate {
  id                 String           @id @default(uuid()) @db.Uuid
  code               DeliveryRateCode @unique
  name               String
  charge             Decimal?         @db.Decimal(14, 2)
  isActive           Boolean          @default(true) @map("is_active")
  updatedByProfileId String?          @map("updated_by_profile_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  updatedBy          Profile?         @relation(fields: [updatedByProfileId], references: [id], onDelete: Restrict)
  orders             SalesOrder[]

  @@map("delivery_rates")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorProfileId String?  @map("actor_profile_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  previousData   Json?    @map("previous_data")
  newData        Json?    @map("new_data")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")
  actor          Profile? @relation(fields: [actorProfileId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model FoundationRecord {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("foundation_records")
}
